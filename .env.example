# Required for live guide generation
ANTHROPIC_API_KEY=
# Optional: model override (defaults to claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional: lets the agent check whether Composio offers managed auth for the app.
# Use a Composio Platform project key (Platform view, Project Settings, API Keys). Keys starting ck_ are consumer keys and are rejected.
COMPOSIO_API_KEY=
